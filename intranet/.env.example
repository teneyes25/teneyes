NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://intranet:intranet@localhost:5432/intranet
CORS_ORIGIN=http://localhost:3000

AUTH_REQUIRED=false
KEYCLOAK_ISSUER=http://localhost:8080/realms/maejong-intranet
KEYCLOAK_AUDIENCE=intranet-api

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=intranet@maejong.local

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

INDUSTRY_NEWS_SCHEDULER_ENABLED=true
INDUSTRY_NEWS_CRON=0 9 * * 1-5
INDUSTRY_NEWS_TIMEZONE=Asia/Seoul
INDUSTRY_NEWS_RSS_URL=https://news.google.com/rss/search?q=%EC%9E%90%EB%8F%99%EC%B0%A8%20%EC%82%B0%EC%97%85&hl=ko&gl=KR&ceid=KR:ko
INDUSTRY_NEWS_MAX_CANDIDATES=10

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
