NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://intranet:intranet@host.docker.internal:5432/intranet
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.6:3000,http://193.168.0.6:3000

AUTH_REQUIRED=false
KEYCLOAK_ISSUER=http://host.docker.internal:8080/realms/maejong-intranet
KEYCLOAK_AUDIENCE=intranet-api

MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_FROM=intranet@maejong.local

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=smollm2:135m
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

INDUSTRY_NEWS_SCHEDULER_ENABLED=true
INDUSTRY_NEWS_CRON=0 9 * * 1-5
INDUSTRY_NEWS_TIMEZONE=Asia/Seoul
INDUSTRY_NEWS_KEYWORDS=침구,매트리스,이불,베개,베게,냉감,모달,양모,침대,극세사,세사,순면,토퍼,쇼파,소파
INDUSTRY_NEWS_MAX_CANDIDATES=30

NEXT_PUBLIC_API_BASE_URL=http://192.168.0.6:4000
